# =========================================================
# ActDesk — Environment Variables (TEMPLATE)
# Copy to .env and fill in your own values.
# =========================================================

# ---- Project ----
PROJECT_NAME=ActDesk Autonomous Support API
VERSION=1.0.0
API_V1_STR=/api/v1

# ---- PostgreSQL ----
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=actdesk_db
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/actdesk_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_CACHE=true

# ---- MongoDB Atlas ----
MONGO_URL=mongodb+srv://your_atlas_user:your_atlas_password@your-cluster.mongodb.net/actdesk?retryWrites=true&w=majority
MONGO_DB=actdesk

# ---- Security ----
SECRET_KEY=replace_with_64_char_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cache TTLs ----
SESSION_TTL_SECONDS=1800
ORDER_STATUS_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Rate limits ----
RATE_LIMIT_PER_MINUTE=60
OTP_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_MINUTE=10

# ---- Seed credentials ----
SEED_ADMIN_USERNAME=Ishleen
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_EMAIL=admin@actdesk.com
SEED_AGENT_USERNAME=agent
SEED_AGENT_PASSWORD=change_me
SEED_AGENT_EMAIL=agent@actdesk.com

# ---- Frontend dev ----
VITE_API_BASE=http://localhost:8000